@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IAsyncDisposable

@inject ChatState ChatState
@inject SessionState Session
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="app" style="--accent:@_accentOverride">
    <header class="topnav">
        <div class="nav-left">
            <svg class="brand-logo" width="34" height="34" viewBox="0 0 34 34" aria-label="BlazerSignalRChat">
                <defs>
                    <linearGradient id="brandGrad" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0" stop-color="#00c6ff" />
                        <stop offset="1" stop-color="#0072ff" />
                    </linearGradient>
                </defs>
                <rect x="1.5" y="1.5" width="31" height="31" rx="9" fill="url(#brandGrad)" />
                <path d="M6 6h22a4 4 0 0 1 4 4v10.5a4 4 0 0 1-4 4H17.5L11 28v-3.5H6a4 4 0 0 1-4-4V10a4 4 0 0 1 4-4z" fill="#fff" />
                <circle cx="12" cy="15.5" r="2" fill="url(#brandGrad)" />
                <circle cx="17" cy="15.5" r="2" fill="url(#brandGrad)" />
                <circle cx="22" cy="15.5" r="2" fill="url(#brandGrad)" />
            </svg>
            <button class="nav-circle" title="Search">🔍</button>
        </div>

        <nav class="nav-tabs">
            <button class="nav-btn active" title="Chats"><span>🏠</span><i class="nav-dot"></i></button>
            <button class="nav-btn" title="Friends (demo)"><span>👥</span></button>
            <button class="nav-btn" title="Videos (demo)"><span>🎬</span></button>
            <button class="nav-btn" title="Marketplace (demo)"><span>🏪</span></button>
            <button class="nav-btn" title="Gaming (demo)"><span>🎮</span></button>
        </nav>

        <div class="nav-right">
            <div class="conn-pill @StatusCss" title="@StatusText">
                <span class="conn-dot"></span>
                <span>@StatusText</span>
            </div>
            <button class="nav-circle" title="Apps (demo)">⊞</button>
            <button class="nav-circle notif" title="Notifications (demo)">
                🔔<span class="notif-badge">3</span>
            </button>
            <label class="nav-user" style="--hue:@(_me?.Hue ?? 0)">
                <span class="avatar xs">@(_me is null ? "?" : InitialOf(_me.DisplayName))</span>
                <select value="@_me?.Id" @onchange="OnUserChanged">
                    @foreach (var u in ChatState.Users)
                    {
                        <option value="@u.Id">@u.DisplayName</option>
                    }
                </select>
                <span class="chev">⌄</span>
            </label>
        </div>
    </header>

    <div class="cards">
        @* ---------------- left: inbox ---------------- *@
        <aside class="card inbox">
            <div class="inbox-head">
                <h1>@PanelTitle</h1>
                <div class="head-actions">
                    <button class="head-btn @(_tab == "friends" ? "on" : "")" title="Friends" @onclick="() => ToggleTab(1)">👥</button>
                    <button class="head-btn @(_tab == "archived" ? "on" : "")" title="Archived" @onclick="() => ToggleTab(2)">📦</button>
                    <button class="head-btn" title="Options (demo)">⋯</button>
                    <button class="head-btn" title="New message (demo)">✏️</button>
                </div>
            </div>

            <div class="search-wrap">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <circle cx="7" cy="7" r="5.25" stroke="#65676b" stroke-width="1.5" />
                    <path d="M11 11l3 3" stroke="#65676b" stroke-width="1.5" stroke-linecap="round" />
                </svg>
                <input id="search-input" class="search-input" placeholder="Search Messenger" value="@_search" @oninput="OnSearch" />
            </div>

            @if (_tab == "chats")
            {
                <div class="filter-chips">
                    <button class="chip-btn @(_filter == "all" ? "active" : "")" @onclick='() => _filter = "all"'>All</button>
                    <button class="chip-btn @(_filter == "unread" ? "active" : "")" @onclick='() => _filter = "unread"'>Unread</button>
                    <button class="chip-btn @(_filter == "groups" ? "active" : "")" @onclick='() => _filter = "groups"'>Groups</button>
                    <button class="chip-btn @(_filter == "communities" ? "active" : "")" @onclick='() => _filter = "communities"'>Communities</button>
                </div>
            }

            <div class="panel">
                @if (_tab == "chats")
                {
                    @foreach (var room in ChatState.Rooms.Where(r => PassesFilter(r.Key, r)))
                    {
                        if (Session.ArchivedRooms.Contains(room.Key)) { continue; }
                        if (!MatchesSearch(room.Title, room.Description)) { continue; }
                        @RoomRow(room)
                    }
                    var visible = ChatState.Rooms.Where(r => PassesFilter(r.Key, r))
                        .Count(r => !Session.ArchivedRooms.Contains(r.Key) && MatchesSearch(r.Title, r.Description));
                    if (visible == 0)
                    {
                        <div class="empty-state">@EmptyText</div>
                    }
                }
                else if (_tab == "friends")
                {
                    @foreach (var u in ChatState.Users)
                    {
                        if (!MatchesSearch(u.DisplayName, u.Bio)) { continue; }
                        <div class="room-row friend-row" @onclick="() => SwitchUser(u.Id)">
                            <div class="avatar has-dot" style="--hue:@u.Hue">
                                @InitialOf(u.DisplayName)
                                <i class="presence-dot @(IsOnline(u.Id) ? "on" : "")"></i>
                            </div>
                            <div class="room-body">
                                <div class="room-top">
                                    <div class="room-title">
                                        @u.DisplayName
                                        @if (u.Id == _me?.Id)
                                        {
                                            <span class="you-tag">you</span>
                                        }
                                    </div>
                                    <div class="room-time @(IsOnline(u.Id) ? "live" : "")">@ChatState.LastSeenText(u.Id)</div>
                                </div>
                                <div class="room-bottom">
                                    <div class="room-desc">@u.Bio</div>
                                    @if (IsOnline(u.Id))
                                    {
                                        <div class="live-dot"></div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    @foreach (var room in ChatState.Rooms)
                    {
                        if (!Session.ArchivedRooms.Contains(room.Key)) { continue; }
                        if (!MatchesSearch(room.Title, room.Description)) { continue; }
                        <div class="room-row">
                            <div class="avatar" style="--hue:@room.Hue">@room.Title[0]</div>
                            <div class="room-body">
                                <div class="room-top">
                                    <div class="room-title">@room.Title</div>
                                </div>
                                <div class="room-bottom">
                                    <div class="room-desc">@room.Description</div>
                                </div>
                            </div>
                            <button class="icon-btn" title="Restore" @onclick="() => ToggleArchive(room.Key)">↺</button>
                        </div>
                    }
                    if (!ChatState.Rooms.Any(r => Session.ArchivedRooms.Contains(r.Key)))
                    {
                        <div class="empty-state">Nothing archived yet.<br />Archive a chat with the 📦 button in its header.</div>
                    }
                }
            </div>

            <footer class="sidebar-footer">5 demo users · 3 chat rooms · open more tabs to chat live</footer>
        </aside>

        @* ---------------- center: conversation ---------------- *@
        <main class="card chat">
            @if (_activeRoom is null || _activeRoomInfo is null)
            {
                <div class="empty-state big"><span class="big-icon">💬</span>Pick a chat to start talking</div>
            }
            else
            {
                <header class="chat-header">
                    <div class="avatar" style="--hue:@_activeRoomInfo.Hue">@_activeRoomInfo.Title[0]</div>
                    <div class="chat-title-wrap">
                        <div class="chat-title">@_activeRoomInfo.Title</div>
                        <div class="chat-sub">@_activeRoomInfo.Description · @_activeMembers.Count member(s), @_activeOnline.Length online</div>
                    </div>
                    <div class="chat-actions">
                        <button class="hdr-icon" title="Voice call (demo)">📞</button>
                        <button class="hdr-icon" title="Video call (demo)">📹</button>
                        <button class="hdr-icon info @(_infoOpen ? "on" : "")" title="Toggle conversation info" @onclick="() => _infoOpen = !_infoOpen">ⓘ</button>
                    </div>
                </header>

                <div class="feed" @ref="_feed">
                    @{ var lastDay = (DateTime?)null; }
                    @foreach (var sys in _systemLines)
                    {
                        <div class="sys-line">@sys</div>
                    }
                    @foreach (var m in _messages)
                    {
                        var day = m.SentAt.ToLocalTime().Date;
                        if (day != lastDay)
                        {
                            lastDay = day;
                            <div class="date-sep">@m.SentAt.ToLocalTime().ToString("M/d/yy, h:mm tt")</div>
                        }
                        var mine = m.User.Id == _me?.Id;
                        var hasRx = _reactions.TryGetValue(m.Id, out var rxD);
                        <div class="msg-row @(mine ? "mine" : "theirs")">
                            @if (!mine)
                            {
                                <div class="avatar sm msg-avatar" style="--hue:@m.User.Hue">@InitialOf(m.User.DisplayName)</div>
                            }
                            <div class="msg">
                                @if (!mine)
                                {
                                    <div class="msg-name">@m.User.DisplayName <span class="msg-time">@m.SentAt.ToLocalTime().ToString("HH:mm")</span></div>
                                }
                                <div class="bubble-wrap">
                                    <div class="bubble">@m.Text</div>
                                    @if (hasRx && rxD!.Count > 0)
                                    {
                                        <div class="reaction-pills">
                                            @foreach (var kv in rxD)
                                            {
                                                <span class="rx-pill">@kv.Key@if (kv.Value.Count > 1){<b>@kv.Value.Count</b>}</span>
                                            }
                                        </div>
                                    }
                                    <button class="react-btn react-trigger" title="Add reaction" @onclick="() => ToggleReactBar(m.Id)">😊</button>
                                    @if (_reactFor == m.Id)
                                    {
                                        <div class="react-bar">
                                            @foreach (var q in QuickReactions)
                                            {
                                                <button class="react-trigger" @onclick="() => ReactNow(m.Id, q)">@q</button>
                                            }
                                        </div>
                                    }
                                </div>
                                @if (mine)
                                {
                                    <div class="msg-time right">@m.SentAt.ToLocalTime().ToString("HH:mm")</div>
                                }
                            </div>
                        </div>
                    }
                    @if (_typing.Any())
                    {
                        <div class="typing-line">
                            <span class="typing-bubble"><i></i><i></i><i></i></span>
                            <span class="typing-label">@TypingLabel</span>
                        </div>
                    }
                </div>

                <footer class="composer">
                    <button class="comp-icon" title="Voice message (demo)">🎤</button>
                    <button class="comp-icon" title="Photo (demo)">🖼️</button>
                    <button class="comp-icon emoji-trigger" title="Stickers & emoji" @onclick="ToggleEmojiPicker">🎞️</button>
                    <button class="comp-icon gif" title="GIF (demo)">GIF</button>

                    <div class="composer-pill">
                        <input id="message-input"
                               class="composer-input"
                               placeholder="Aa"
                               value="@_input"
                               @oninput="OnInput"
                               @onkeydown="OnKeyDown"
                               @onblur="StopTyping" />
                        <button class="pill-icon emoji-trigger" title="Emoji" @onclick="ToggleEmojiPicker">😊</button>
                    </div>

                    @if (string.IsNullOrWhiteSpace(_input))
                    {
                        <button class="like-btn" title="Send a like" @onclick="SendLike">👍</button>
                    }
                    else
                    {
                        <button class="like-btn send" title="Send" disabled="@(_hub?.State != HubConnectionState.Connected)" @onclick="SendMessage">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                <path d="M3.4 20.4l17.45-7.48a1 1 0 0 0 0-1.84L3.4 3.6a.993.993 0 0 0-1.39.91L2 9.12c0 .5.37.93.87.99L17 12 2.87 13.88c-.5.07-.87.5-.87 1l.01 4.61c0 .71.73 1.2 1.39.91z" />
                            </svg>
                        </button>
                    }

                    @if (_emojiOpen)
                    {
                        <div class="emoji-pop">
                            <div class="emoji-search">
                                <input placeholder="Search emoji" value="@_emojiSearch" @oninput="OnEmojiSearch" />
                            </div>
                            <div class="emoji-tabs">
                                @for (var i = 0; i < EmojiCategories.Length; i++)
                                {
                                    var idx = i;
                                    <button class="@(_emojiCat == idx ? "active" : "")" title="@EmojiCategories[idx].Name" @onclick="() => _emojiCat = idx">@EmojiCategories[idx].Icon</button>
                                }
                            </div>
                            <div class="emoji-grid">
                                @foreach (var item in PickerItems)
                                {
                                    <button class="emoji-item" @onclick="() => InsertEmoji(item)">@item</button>
                                }
                                @if (!PickerItems.Any())
                                {
                                    <div class="emoji-none">No emoji found</div>
                                }
                            </div>
                        </div>
                    }
                </footer>
            }
        </main>

        @* ---------------- right: conversation profile ---------------- *@
        @if (_infoOpen && _activeRoomInfo is not null)
        {
            <aside class="card profile">
                <div class="profile-hero">
                    <div class="avatar xl" style="--hue:@_activeRoomInfo.Hue">@_activeRoomInfo.Title[0]</div>
                    <div class="profile-name">@_activeRoomInfo.Title</div>
                    <div class="profile-sub">@(IsOnline(_me?.Id ?? "") ? "Active now" : ChatState.LastSeenText(_me?.Id ?? ""))</div>
                    <div class="e2e-pill">🔒 SignalR-secured demo</div>

                    <div class="profile-actions">
                        <button class="pa-btn" title="Show members list" @onclick='() => ShowTab(1)'>
                            <i>👤</i><span>Profile</span>
                        </button>
                        <button class="pa-btn @(_muted ? "on" : "")" title="Mute this chat" @onclick='() => _muted = !_muted'>
                            <i>@(_muted ? "🔕" : "🔔")</i><span>@(_muted ? "Muted" : "Mute")</span>
                        </button>
                        <button class="pa-btn" title="Search this chat" @onclick="FocusSearch">
                            <i>🔍</i><span>Search</span>
                        </button>
                    </div>
                </div>

                <div class="profile-sections">
                    <div class="p-section">
                        <button class="p-head" @onclick='() => ToggleAcc("info")'>
                            <span>Chat info</span><span class="p-chev">@(_accInfo ? "⌃" : "⌄")</span>
                        </button>
                        @if (_accInfo)
                        {
                            <div class="p-body members">
                                @foreach (var u in MemberProfiles)
                                {
                                    <div class="mem-row @(u.Id == _me?.Id ? "self" : "")">
                                        <div class="avatar sm has-dot" style="--hue:@u.Hue">
                                            @InitialOf(u.DisplayName)
                                            <i class="presence-dot @(IsOnline(u.Id) ? "on" : "")"></i>
                                        </div>
                                        <div class="mem-body">
                                            <div class="mem-name">
                                                @u.DisplayName
                                                @if (u.Id == _me?.Id)
                                                {
                                                    <span class="you-tag">you</span>
                                                }
                                            </div>
                                            <div class="mem-bio">@u.Bio</div>
                                        </div>
                                        <div class="mem-status @(IsOnline(u.Id) ? "live" : "")">@ChatState.LastSeenText(u.Id)</div>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div class="p-section">
                        <button class="p-head" @onclick='() => ToggleAcc("theme")'>
                            <span>Customize chat</span><span class="p-chev">@(_accTheme ? "⌃" : "⌄")</span>
                        </button>
                        @if (_accTheme)
                        {
                            <div class="p-body">
                                <div class="theme-swatches">
                                    @foreach (var c in AccentColors)
                                    {
                                        <button class="swatch @(_accentOverride == c ? "on" : "")" style="--sw:@c" title="@c" @onclick="() => _accentOverride = c"></button>
                                    }
                                </div>
                                <div class="p-note">Bubble theme for this tab.</div>
                            </div>
                        }
                    </div>

                    <div class="p-section">
                        <button class="p-head" @onclick='() => ToggleAcc("media")'>
                            <span>Media &amp; files</span><span class="p-chev">@(_accMedia ? "⌃" : "⌄")</span>
                        </button>
                        @if (_accMedia)
                        {
                            <div class="p-body"><div class="p-note">No media shared yet 🖼️</div></div>
                        }
                    </div>

                    <div class="p-section">
                        <button class="p-head" @onclick='() => ToggleAcc("privacy")'>
                            <span>Privacy &amp; support</span><span class="p-chev">@(_accPrivacy ? "⌃" : "⌄")</span>
                        </button>
                        @if (_accPrivacy)
                        {
                            <div class="p-body"><div class="p-note">Demo only — messages live in server memory.</div></div>
                        }
                    </div>
                </div>
            </aside>
        }
    </div>
</div>

