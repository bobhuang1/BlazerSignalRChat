    private IEnumerable<string> PickerItems
    {
        get
        {
            var q = _emojiSearch.Trim();
            if (q.Length == 0) return EmojiCategories[_emojiCat].Items.Select(EmojiOf);
            return EmojiCategories.SelectMany(c => c.Items)
                .Where(i => KeywordsOf(i).Contains(q, StringComparison.OrdinalIgnoreCase))
                .Select(EmojiOf)
                .ToList();
        }
    }

    private static string EmojiOf(string item) => item.Split('|')[0];
    private static string KeywordsOf(string item)
    {
        var i = item.IndexOf('|');
        return i < 0 ? "" : item[(i + 1)..];
    }

    protected override async Task OnInitializedAsync()
    {
        var stored = await JS.InvokeAsync<string>("sessionStorage.getItem", StorageKey).AsTask();
        var userId = string.IsNullOrEmpty(stored) ? Session.CurrentUserId : stored;
        if (ChatState.GetUser(userId) is { } user)
        {
            _me = user;
            Session.CurrentUserId = user.Id;
        }
        else
        {
            _me = ChatState.GetUser("alice");
        }
        _activeRoomInfo = ChatState.GetRoom(_activeRoom);
        await ConnectHub();
    }

    private async Task ConnectHub()
    {
        _status = "connecting";

        var hubUrl = $"{Nav.ToAbsoluteUri("/chat")}?user={Uri.EscapeDataString(_me!.Id)}";
        var hub = new HubConnectionBuilder()
            .WithUrl(hubUrl)
            .WithAutomaticReconnect()
            .Build();

        hub.On<string, List<ChatMessage>, List<ChatUser>>("JoinedRoom", (room, history, participants) =>
        {
            if (room == _activeRoom)
            {
                _messages = history;
                _activeMembers = participants.Select(p => p.Id).ToList();
                _typing.Clear();
                _systemLines.Clear();
            }
            foreach (var m in history)
            {
                if (m.Reactions.Count > 0)
                {
                    _reactions[m.Id] = m.Reactions.ToDictionary(
                        kv => kv.Key,
                        kv => new HashSet<string>(kv.Value, StringComparer.Ordinal));
                }
            }
            _ = InvokeAsync(StateHasChanged);
        });
        hub.On<ChatMessage>("ReceiveMessage", msg =>
        {
            if (Session.ArchivedRooms.Contains(msg.RoomKey)) return;
            if (msg.RoomKey == _activeRoom)
            {
                if (_messages.All(m => m.Id != msg.Id))
                {
                    _messages.Add(msg);
                }
                _typing.Remove(msg.User.Id);
            }
            else
            {
                Session.Unread.TryGetValue(msg.RoomKey, out var c);
                Session.Unread[msg.RoomKey] = c + 1;
            }
            _ = InvokeAsync(StateHasChanged);
        });
        hub.On<string, string>("SystemEvent", (room, line) =>
        {
            if (room == _activeRoom)
            {
                _systemLines.Add(line);
                if (_systemLines.Count > 20) _systemLines.RemoveAt(0);
            }
            _ = InvokeAsync(StateHasChanged);
        });
        hub.On<string, string[]>("TypingChanged", (room, ids) =>
        {
            if (room == _activeRoom)
            {
                _typing = ids.Where(id => id != _me!.Id).ToHashSet();
            }
            _ = InvokeAsync(StateHasChanged);
        });
        hub.On<string[]>("OnlineUsersChanged", ids =>
        {
            _ = InvokeAsync(StateHasChanged);
        });
        hub.On<string, string[]>("RoomPresenceChanged", (room, ids) =>
        {
            if (room == _activeRoom)
            {
                _activeOnline = ids;
            }
            _ = InvokeAsync(StateHasChanged);
        });
        hub.On<long, string, string[]>("ReactionChanged", (msgId, emoji, userIds) =>
        {
            if (!_reactions.TryGetValue(msgId, out var dict))
            {
                dict = new Dictionary<string, HashSet<string>>();
                _reactions[msgId] = dict;
            }
            if (userIds.Length == 0) dict.Remove(emoji);
            else dict[emoji] = userIds.ToHashSet(StringComparer.Ordinal);
            _ = InvokeAsync(StateHasChanged);
        });

        hub.Reconnecting += ex =>
        {
            _status = "reconnecting";
            _ = InvokeAsync(StateHasChanged);
            return Task.CompletedTask;
        };
        hub.Reconnected += async ctx =>
        {
            _status = "connected";
            try { await JoinAllRooms(); } catch { }
            _ = InvokeAsync(StateHasChanged);
        };
        hub.Closed += ex =>
        {
            _status = _status == "reconnecting" ? "reconnecting" : "failed";
            _ = InvokeAsync(StateHasChanged);
            return Task.CompletedTask;
        };

        _hub = hub;
        await hub.StartAsync();
        _status = "connected";
        await JoinAllRooms();
        StateHasChanged();
    }

    private async Task JoinAllRooms()
    {
        if (_hub is not { State: HubConnectionState.Connected }) return;
        foreach (var room in ChatState.Rooms)
        {
            if (!Session.ArchivedRooms.Contains(room.Key))
            {
                await _hub.SendAsync("JoinRoom", room.Key);
            }
        }
    }

    private async Task StopHub()
    {
        if (_hub is not null)
        {
            try { await _hub.StopAsync(); } catch { }
            _hub = null;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_status == "connected")
        {
            await JS.InvokeVoidAsync("chatScroll", _feed);
        }
        _closerRef ??= DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("chatBindCloser", _closerRef, ".emoji-pop, .react-bar", ".emoji-trigger, .react-trigger");
    }

    [JSInvokable]
    public Task ClosePopovers()
    {
        var changed = _emojiOpen || _reactFor is not null;
        _emojiOpen = false;
        _reactFor = null;
        if (changed) StateHasChanged();
        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("chatUnbindCloser"); } catch { }
        _closerRef?.Dispose();
        await StopHub();
    }

    private void OnSearch(ChangeEventArgs e) => _search = e.Value?.ToString() ?? "";

    private bool MatchesSearch(string primary, string secondary)
    {
        if (string.IsNullOrWhiteSpace(_search)) return true;
        return primary.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || secondary.Contains(_search, StringComparison.OrdinalIgnoreCase);
    }

    private IEnumerable<ChatUser> MemberProfiles
    {
        get
        {
            var list = _activeMembers
                .Select(ChatState.GetUser)
                .Where(u => u is not null)
                .Cast<ChatUser>()
                .ToList();
            return list
                .OrderByDescending(u => u.Id == _me?.Id)
                .ThenByDescending(u => IsOnline(u.Id))
                .ThenBy(u => u.DisplayName, StringComparer.OrdinalIgnoreCase);
        }
    }

    private bool PassesFilter(string key, ChatRoom room) => _filter switch
    {
        "unread" => Session.Unread.TryGetValue(key, out var c) && c > 0,
        "groups" => room.Kind == "group",
        "communities" => room.Kind == "community",
        _ => true
    };

    private string EmptyText => _filter switch
    {
        "unread" => "No unread chats 🎉",
        "groups" => "No group chats",
        "communities" => "No communities",
        _ => "No chats here"
    };

    private async Task OnUserChanged(ChangeEventArgs e)
    {
        var id = e.Value?.ToString();
        if (id is null) return;
        await SwitchUser(id);
    }

    private async Task SwitchUser(string id)
    {
        if (id == _me?.Id) return;
        await StopHub();
        _me = ChatState.GetUser(id);
        Session.CurrentUserId = id!;
        Session.Unread.Clear();
        _messages = new();
        _typing.Clear();
        _systemLines.Clear();
        _reactions.Clear();
        await JS.InvokeVoidAsync("sessionStorage.setItem", StorageKey, id);
        await ConnectHub();
    }

    private void ShowTab(int index) => _tab = index switch
    {
        0 => "chats",
        1 => "friends",
        _ => "archived"
    };

    private void ToggleTab(int index)
    {
        var target = index switch { 1 => "friends", 2 => "archived", _ => "chats" };
        ShowTab(_tab == target ? 0 : index);
    }

    private async Task SelectRoom(string roomKey)
    {
        if (roomKey == _activeRoom) return;
        if (Session.ArchivedRooms.Contains(roomKey)) return;
        _activeRoom = roomKey;
        _activeRoomInfo = ChatState.GetRoom(roomKey);
        Session.Unread[roomKey] = 0;
        _messages = new();
        _typing.Clear();
        _systemLines.Clear();
        if (_hub is { State: HubConnectionState.Connected })
        {
            try
            {
                await _hub.SendAsync("JoinRoom", roomKey);
            }
            catch { }
        }
    }

    private async Task ToggleArchive(string? roomKey)
    {
        if (roomKey is null) return;
        if (Session.ArchivedRooms.Contains(roomKey))
        {
            Session.ArchivedRooms.Remove(roomKey);
        }
        else
        {
            Session.ArchivedRooms.Add(roomKey);
            Session.Unread[roomKey] = 0;
            if (roomKey == _activeRoom)
            {
                _messages = new();
                _typing.Clear();
            }
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_input))
        {
            await SendMessage();
        }
    }

    private void OnInput(ChangeEventArgs e)
    {
        _input = e.Value?.ToString() ?? "";
        if (_hub is { State: HubConnectionState.Connected } && !string.IsNullOrWhiteSpace(_input))
        {
            if ((DateTimeOffset.Now - _lastTypeSentAt).TotalMilliseconds > 500)
            {
                _lastTypeSentAt = DateTimeOffset.Now;
                _ = FireTyping(true);
            }
        }
    }

    private void StopTyping() => _ = FireTyping(false);

    private async Task FireTyping(bool typing)
    {
        if (_hub is null) return;
        var room = _activeRoom;
        try { await _hub.SendAsync("UserTyping", room, typing); } catch { }
    }

    private async Task SendMessage()
    {
        var text = _input.Trim();
        _input = "";
        if (string.IsNullOrEmpty(text) || _hub is not { State: HubConnectionState.Connected }) return;
        await FireTyping(false);
        try
        {
            await _hub.SendAsync("SendMessage", _activeRoom, text);
        }
        catch { }
        await JS.InvokeVoidAsync("chatFocus", "message-input");
    }

    private async Task SendLike()
    {
        _input = "👍";
        await SendMessage();
    }

    private void ToggleEmojiPicker() => _emojiOpen = !_emojiOpen;

    private void OnEmojiSearch(ChangeEventArgs e) => _emojiSearch = e.Value?.ToString() ?? "";

    private void InsertEmoji(string emoji)
    {
        _input += emoji;
        _ = JS.InvokeVoidAsync("chatFocus", "message-input");
    }

    private void ToggleReactBar(long msgId) => _reactFor = _reactFor == msgId ? null : msgId;

    private async Task ReactNow(long msgId, string emoji)
    {
        _reactFor = null;
        if (_hub is not { State: HubConnectionState.Connected }) return;
        try { await _hub.SendAsync("React", msgId, emoji); } catch { }
    }

    private Task FocusSearch()
    {
        ShowTab(0);
        return JS.InvokeVoidAsync("chatFocus", "search-input").AsTask();
    }

    private void ToggleAcc(string which)
    {
        _accInfo = which == "info" ? !_accInfo : _accInfo;
        _accTheme = which == "theme" ? !_accTheme : _accTheme;
        _accMedia = which == "media" ? !_accMedia : _accMedia;
        _accPrivacy = which == "privacy" ? !_accPrivacy : _accPrivacy;
    }

    private bool IsOnline(string id) => ChatState.IsOnline(id);

    private static string InitialOf(string name) => name.Length > 0 ? name[0].ToString() : "?";

    // Razor-local helpers reused in markup lambdas.
    private RenderFragment RoomRow(ChatRoom room) => __builder =>
    {
        <div class="room-row @(room.Key == _activeRoom ? "active" : "")" @onclick="() => SelectRoom(room.Key)">
            <div class="avatar" style="--hue:@room.Hue">@room.Title[0]</div>
            <div class="room-body">
                <div class="room-top">
                    <div class="room-title">@room.Title</div>
                    <div class="room-time">
                        @if (ChatState.LastMessage(room.Key) is { } last)
                        {
                            <text>@last.SentAt.ToLocalTime().ToString("HH:mm")</text>
                        }
                    </div>
                </div>
                <div class="room-bottom">
                    <div class="room-desc">
                        @if (ChatState.LastMessage(room.Key) is { } preview)
                        {
                            <text>@preview.User.DisplayName: @preview.Text</text>
                        }
                        else
                        {
                            <text>No messages yet</text>
                        }
                    </div>
                    <div class="row-right">
                        @if (Session.Unread.TryGetValue(room.Key, out var unread) && unread > 0)
                        {
                            <span class="unread-dot">@unread</span>
                        }
                        else if (room.Key == _activeRoom && _activeOnline.Length > 0)
                        {
                            <span class="online-count">●</span>
                        }
                    </div>
                </div>
            </div>
        </div>;
    };
}