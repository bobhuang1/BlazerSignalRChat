@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inject ChatState ChatState
@inject SessionState Session
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="messenger">
    <header class="topbar">
        <div class="brand">
            <svg class="brand-logo" width="34" height="34" viewBox="0 0 34 34" aria-hidden="true">
                <defs>
                    <linearGradient id="brandGrad" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0" stop-color="#00c6ff" />
                        <stop offset="1" stop-color="#0072ff" />
                    </linearGradient>
                </defs>
                <rect x="1.5" y="1.5" width="31" height="31" rx="9" fill="url(#brandGrad)" />
                <path d="M6 6h22a4 4 0 0 1 4 4v10.5a4 4 0 0 1-4 4H17.5L11 28v-3.5H6a4 4 0 0 1-4-4V10a4 4 0 0 1 4-4z" fill="#fff" />
                <circle cx="12" cy="15.5" r="2" fill="url(#brandGrad)" />
                <circle cx="17" cy="15.5" r="2" fill="url(#brandGrad)" />
                <circle cx="22" cy="15.5" r="2" fill="url(#brandGrad)" />
            </svg>
            <div class="brand-text">
                <div class="brand-name">BlazerSignalRChat</div>
                <div class="brand-tagline">Blazor Server · SignalR demo</div>
            </div>
        </div>

        <div class="topbar-actions">
            <div class="header-icons">
                <button class="icon-btn" title="Video call (demo)">🎥</button>
                <button class="icon-btn" title="Voice call (demo)">📞</button>
            </div>

            <div class="conn-pill @StatusCss" title="@StatusText">
                <span class="conn-dot"></span>
                <span>@StatusText</span>
            </div>

            <div class="user-switcher">
                <span class="switcher-label">Chatting as</span>
                <label class="switcher-control" style="--hue:@(_me?.Hue ?? 0)">
                    <span class="avatar xs">@(_me is null ? "?" : InitialOf(_me.DisplayName))</span>
                    <select value="@_me?.Id" @onchange="OnUserChanged">
                        @foreach (var u in ChatState.Users)
                        {
                            <option value="@u.Id">@u.DisplayName</option>
                        }
                    </select>
                </label>
            </div>
        </div>
    </header>

    <div class="app-body">
        <aside class="sidebar">
            <div class="search-wrap">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <circle cx="7" cy="7" r="5.25" stroke="#65676b" stroke-width="1.5" />
                    <path d="M11 11l3 3" stroke="#65676b" stroke-width="1.5" stroke-linecap="round" />
                </svg>
                <input class="search-input" placeholder="Search Messenger" value="@_search" @oninput="OnSearch" />
            </div>

            <nav class="tabs">
                <button class="tab @(_tab == "chats" ? "active" : "")" @onclick="() => ShowTab(0)">
                    Chats
                    @if (TotalUnread > 0)
                    {
                        <span class="badge">@TotalUnread</span>
                    }
                </button>
                <button class="tab @(_tab == "friends" ? "active" : "")" @onclick="() => ShowTab(1)">Friends</button>
                <button class="tab @(_tab == "archived" ? "active" : "")" @onclick="() => ShowTab(2)">Archived</button>
            </nav>

            @if (_tab == "chats")
            {
                <div class="filter-chips">
                    <button class="chip-btn @(_filter == "all" ? "active" : "")" @onclick='() => _filter = "all"'>All</button>
                    <button class="chip-btn @(_filter == "unread" ? "active" : "")" @onclick='() => _filter = "unread"'>Unread</button>
                    <button class="chip-btn @(_filter == "groups" ? "active" : "")" @onclick='() => _filter = "groups"'>Groups</button>
                    <button class="chip-btn @(_filter == "communities" ? "active" : "")" @onclick='() => _filter = "communities"'>Communities</button>
                </div>
            }

            <div class="panel">
                @if (_tab == "chats")
                {
                    @foreach (var room in ChatState.Rooms.Where(r => PassesFilter(r.Key, r)))
                    {
                        if (Session.ArchivedRooms.Contains(room.Key)) { continue; }
                        if (!MatchesSearch(room.Title, room.Description)) { continue; }
                        @RoomRow(room)
                    }
                    var visible = ChatState.Rooms.Where(r => PassesFilter(r.Key, r))
                        .Count(r => !Session.ArchivedRooms.Contains(r.Key) && MatchesSearch(r.Title, r.Description));
                    if (visible == 0)
                    {
                        <div class="empty-state">@EmptyText</div>
                    }
                }
                else if (_tab == "friends")
                {
                    @foreach (var u in ChatState.Users)
                    {
                        if (!MatchesSearch(u.DisplayName, u.Bio)) { continue; }
                        <div class="friend-row" @onclick="() => SwitchUser(u.Id)">
                            <div class="avatar has-dot" style="--hue:@u.Hue">
                                @InitialOf(u.DisplayName)
                                <i class="presence-dot @(IsOnline(u.Id) ? "on" : "")"></i>
                            </div>
                            <div class="room-body">
                                <div class="room-top">
                                    <div class="room-title">
                                        @u.DisplayName
                                        @if (u.Id == _me?.Id)
                                        {
                                            <span class="you-tag">you</span>
                                        }
                                    </div>
                                    <div class="room-time @(IsOnline(u.Id) ? "live" : "")">@ChatState.LastSeenText(u.Id)</div>
                                </div>
                                <div class="room-bottom">
                                    <div class="room-desc">@u.Bio</div>
                                    @if (IsOnline(u.Id))
                                    {
                                        <div class="live-dot"></div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    @foreach (var room in ChatState.Rooms)
                    {
                        if (!Session.ArchivedRooms.Contains(room.Key)) { continue; }
                        if (!MatchesSearch(room.Title, room.Description)) { continue; }
                        <div class="room-row">
                            <div class="avatar" style="--hue:@room.Hue">@room.Title[0]</div>
                            <div class="room-body">
                                <div class="room-top">
                                    <div class="room-title">@room.Title</div>
                                </div>
                                <div class="room-bottom">
                                    <div class="room-desc">@room.Description</div>
                                </div>
                            </div>
                            <button class="icon-btn" title="Restore" @onclick="() => ToggleArchive(room.Key)">↺</button>
                        </div>
                    }
                    if (!ChatState.Rooms.Any(r => Session.ArchivedRooms.Contains(r.Key)))
                    {
                        <div class="empty-state">Nothing archived yet.<br />Archive a chat with the 📦 button its header.</div>
                    }
                }
            </div>

            <footer class="sidebar-footer">5 demo users · 3 chat rooms · open more tabs to chat live</footer>
        </aside>

        <main class="chat">
            @if (_activeRoom is null || _activeRoomInfo is null)
            {
                <div class="empty-state big"><span class="big-icon">💬</span>Pick a chat to start talking</div>
            }
            else
            {
                <div class="chat-col">
                    <header class="chat-header">
                    <div class="chat-title-wrap">
                        <div class="chat-title">@_activeRoomInfo.Title</div>
                        <div class="chat-sub">@_activeRoomInfo.Description · @_activeMembers.Count member(s), @_activeOnline.Length online</div>
                    </div>
                    <div class="member-chips">
                        @foreach (var pid in _activeMembers)
                        {
                            var u = ChatState.GetUser(pid);
                            if (u is null) { continue; }
                            <span class="chip" title="@u.DisplayName">
                                <div class="avatar sm has-dot" style="--hue:@u.Hue">
                                    <i class="presence-dot @(IsOnline(u.Id) ? "on" : "")"></i>@InitialOf(u.DisplayName)
                                </div>
                            </span>
                        }
                    </div>
                    <button class="icon-btn" title="@(IsArchived ? "Restore chat" : "Archive chat")" @onclick="() => ToggleArchive(_activeRoom)">
                        @(IsArchived ? "↺" : "📦")
                    </button>
                </header>

                <div class="feed" @ref="_feed">
                    <div class="date-divider">Today</div>
                    @foreach (var sys in _systemLines)
                    {
                        <div class="sys-line">@sys</div>
                    }
                    @foreach (var m in _messages)
                    {
                        var mine = m.User.Id == _me?.Id;
                        <div class="msg-row @(mine ? "mine" : "theirs")">
                            @if (!mine)
                            {
                                <div class="avatar sm msg-avatar" style="--hue:@m.User.Hue">@InitialOf(m.User.DisplayName)</div>
                            }
                            <div class="msg">
                                @if (!mine)
                                {
                                    <div class="msg-name">@m.User.DisplayName <span class="msg-time">@m.SentAt.ToLocalTime().ToString("HH:mm")</span></div>
                                }
                                <div class="bubble">@m.Text</div>
                                @if (mine)
                                {
                                    <div class="msg-time right">@m.SentAt.ToLocalTime().ToString("HH:mm")</div>
                                }
                            </div>
                        </div>
                    }
                    @if (_typing.Any())
                    {
                        <div class="typing-line">
                            <span class="typing-bubble"><i></i><i></i><i></i></span>
                            <span class="typing-label">@TypingLabel</span>
                        </div>
                    }
                </div>

                <footer class="composer">
                    <input id="message-input"
                           class="composer-input"
                           placeholder="Message @_activeRoomInfo.Title…"
                           value="@_input"
                           @oninput="OnInput"
                           @onkeydown="OnKeyDown"
                           @onblur="StopTyping" />
                    <button class="send-btn" disabled="@(string.IsNullOrWhiteSpace(_input) || _hub?.State != HubConnectionState.Connected)" @onclick="SendMessage">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M3.4 20.4l17.45-7.48a1 1 0 0 0 0-1.84L3.4 3.6a.993.993 0 0 0-1.39.91L2 9.12c0 .5.37.93.87.99L17 12 2.87 13.88c-.5.07-.87.5-.87 1l.01 4.61c0 .71.73 1.2 1.39.91z" />
                        </svg>
                    </button>
                </footer>
                </div>

                <aside class="chat-meta">
                    <div class="meta-header">
                        <div class="meta-title">Members</div>
                        <div class="meta-sub">@_activeMembers.Count · @_activeOnline.Length online</div>
                    </div>
                    <div class="meta-list">
                        @foreach (var u in MemberProfiles)
                        {
                            <div class="mem-row @(u.Id == _me?.Id ? "self" : "")">
                                <div class="avatar has-dot" style="--hue:@u.Hue">
                                    @InitialOf(u.DisplayName)
                                    <i class="presence-dot @(IsOnline(u.Id) ? "on" : "")"></i>
                                </div>
                                <div class="mem-body">
                                    <div class="mem-name">
                                        @u.DisplayName
                                        @if (u.Id == _me?.Id)
                                        {
                                            <span class="you-tag">you</span>
                                        }
                                    </div>
                                    <div class="mem-bio">@u.Bio</div>
                                </div>
                                <div class="mem-status @(IsOnline(u.Id) ? "live" : "")">@ChatState.LastSeenText(u.Id)</div>
                            </div>
                        }
                    </div>
                </aside>
            }
        </main>
    </div>
</div>

@code {
    private const string StorageKey = "bsc_user";

    private HubConnection? _hub;
    private string _tab = "chats";
    private string _filter = "all";
    private string _search = "";
    private string _activeRoom = "general";
    private ChatUser? _me;
    private ChatRoom? _activeRoomInfo;
    private List<ChatMessage> _messages = new();
    private List<string> _systemLines = new();
    private HashSet<string> _typing = new();
    private List<string> _activeMembers = new();
    private string[] _activeOnline = Array.Empty<string>();
    private string _input = "";
    private string _status = "connecting";
    private DateTimeOffset _lastTypeSentAt;
    private ElementReference _feed;

    private int TotalUnread => Session.Unread.Values.Sum();
    private bool IsArchived => Session.ArchivedRooms.Contains(_activeRoom);
    private string StatusText => _status switch
    {
        "connected" => "Connected",
        "reconnecting" => "Reconnecting…",
        "failed" => "Offline",
        _ => "Connecting…"
    };
    private string StatusCss => _status switch
    {
        "connected" => "ok",
        "reconnecting" => "warn",
        "failed" => "bad",
        _ => "idle"
    };
    private string TypingLabel
    {
        get
        {
            var names = _typing.Select(id => ChatState.GetUser(id)?.DisplayName).Where(n => n is not null).Cast<string>().ToList();
            return names.Count switch
            {
                0 => "",
                1 => $"{names[0]} is typing…",
                2 => $"{names[0]} and {names[1]} are typing…",
                _ => $"{string.Join(", ", names.Take(names.Count - 1))} and {names[^1]} are typing…"
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var stored = await JS.InvokeAsync<string>("sessionStorage.getItem", StorageKey).AsTask();
        var userId = string.IsNullOrEmpty(stored) ? Session.CurrentUserId : stored;
        if (ChatState.GetUser(userId) is { } user)
        {
            _me = user;
            Session.CurrentUserId = user.Id;
        }
        else
        {
            _me = ChatState.GetUser("alice");
        }
        _activeRoomInfo = ChatState.GetRoom(_activeRoom);
        await ConnectHub();
    }

    private async Task ConnectHub()
    {
        _status = "connecting";

        var hubUrl = $"{Nav.ToAbsoluteUri("/chat")}?user={Uri.EscapeDataString(_me!.Id)}";
        var hub = new HubConnectionBuilder()
            .WithUrl(hubUrl)
            .WithAutomaticReconnect()
            .Build();

        hub.On<string, List<ChatMessage>, List<ChatUser>>("JoinedRoom", (room, history, participants) =>
        {
            if (room == _activeRoom)
            {
                _messages = history;
                _activeMembers = participants.Select(p => p.Id).ToList();
                _typing.Clear();
                _systemLines.Clear();
            }
            _ = InvokeAsync(StateHasChanged);
        });
        hub.On<ChatMessage>("ReceiveMessage", msg =>
        {
            if (Session.ArchivedRooms.Contains(msg.RoomKey)) return;
            if (msg.RoomKey == _activeRoom)
            {
                if (_messages.All(m => m.Id != msg.Id))
                {
                    _messages.Add(msg);
                }
                _typing.Remove(msg.User.Id);
            }
            else
            {
                Session.Unread.TryGetValue(msg.RoomKey, out var c);
                Session.Unread[msg.RoomKey] = c + 1;
            }
            _ = InvokeAsync(StateHasChanged);
        });
        hub.On<string, string>("SystemEvent", (room, line) =>
        {
            if (room == _activeRoom)
            {
                _systemLines.Add(line);
                if (_systemLines.Count > 20) _systemLines.RemoveAt(0);
            }
            _ = InvokeAsync(StateHasChanged);
        });
        hub.On<string, string[]>("TypingChanged", (room, ids) =>
        {
            if (room == _activeRoom)
            {
                _typing = ids.Where(id => id != _me!.Id).ToHashSet();
            }
            _ = InvokeAsync(StateHasChanged);
        });
        hub.On<string[]>("OnlineUsersChanged", ids =>
        {
            _ = InvokeAsync(StateHasChanged);
        });
        hub.On<string, string[]>("RoomPresenceChanged", (room, ids) =>
        {
            if (room == _activeRoom)
            {
                _activeOnline = ids;
            }
            _ = InvokeAsync(StateHasChanged);
        });

        hub.Reconnecting += ex =>
        {
            _status = "reconnecting";
            _ = InvokeAsync(StateHasChanged);
            return Task.CompletedTask;
        };
        hub.Reconnected += async ctx =>
        {
            _status = "connected";
            try { await JoinAllRooms(); } catch { }
            _ = InvokeAsync(StateHasChanged);
        };
        hub.Closed += ex =>
        {
            _status = _status == "reconnecting" ? "reconnecting" : "failed";
            _ = InvokeAsync(StateHasChanged);
            return Task.CompletedTask;
        };

        _hub = hub;
        await hub.StartAsync();
        _status = "connected";
        await JoinAllRooms();
        StateHasChanged();
    }

    private async Task JoinAllRooms()
    {
        if (_hub is not { State: HubConnectionState.Connected }) return;
        foreach (var room in ChatState.Rooms)
        {
            if (!Session.ArchivedRooms.Contains(room.Key))
            {
                await _hub.SendAsync("JoinRoom", room.Key);
            }
        }
    }

    private async Task StopHub()
    {
        if (_hub is not null)
        {
            try { await _hub.StopAsync(); } catch { }
            _hub = null;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_status == "connected")
        {
            await JS.InvokeVoidAsync("chatScroll", _feed);
        }
    }

    public async ValueTask DisposeAsync()
    {
        await StopHub();
    }

    private void OnSearch(ChangeEventArgs e) => _search = e.Value?.ToString() ?? "";

    private IEnumerable<ChatUser> MemberProfiles
    {
        get
        {
            var list = _activeMembers
                .Select(ChatState.GetUser)
                .Where(u => u is not null)
                .Cast<ChatUser>()
                .ToList();
            return list
                .OrderByDescending(u => u.Id == _me?.Id)
                .ThenByDescending(u => IsOnline(u.Id))
                .ThenBy(u => u.DisplayName, StringComparer.OrdinalIgnoreCase);
        }
    }

    private bool PassesFilter(string key, ChatRoom room) => _filter switch
    {
        "unread" => Session.Unread.TryGetValue(key, out var c) && c > 0,
        "groups" => room.Kind == "group",
        "communities" => room.Kind == "community",
        _ => true
    };

    private string EmptyText => _filter switch
    {
        "unread" => "No unread chats 🎉",
        "groups" => "No group chats",
        "communities" => "No communities",
        _ => "No chats here"
    };

    private bool MatchesSearch(string primary, string secondary)
    {
        if (string.IsNullOrWhiteSpace(_search)) return true;
        return primary.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || secondary.Contains(_search, StringComparison.OrdinalIgnoreCase);
    }

    private async Task OnUserChanged(ChangeEventArgs e)
    {
        var id = e.Value?.ToString();
        if (id is null) return;
        await SwitchUser(id);
    }

    private async Task SwitchUser(string id)
    {
        if (id == _me?.Id) return;
        await StopHub();
        _me = ChatState.GetUser(id);
        Session.CurrentUserId = id!;
        Session.Unread.Clear();
        _messages = new();
        _typing.Clear();
        _systemLines.Clear();
        await JS.InvokeVoidAsync("sessionStorage.setItem", StorageKey, id);
        await ConnectHub();
    }

    private void ShowTab(int index) => _tab = index switch
    {
        0 => "chats",
        1 => "friends",
        _ => "archived"
    };

    private async Task SelectRoom(string roomKey)
    {
        if (roomKey == _activeRoom) return;
        if (Session.ArchivedRooms.Contains(roomKey)) return;
        _activeRoom = roomKey;
        _activeRoomInfo = ChatState.GetRoom(roomKey);
        Session.Unread[roomKey] = 0;
        _messages = new();
        _typing.Clear();
        _systemLines.Clear();
        if (_hub is { State: HubConnectionState.Connected })
        {
            try
            {
                await _hub.SendAsync("JoinRoom", roomKey);
            }
            catch { }
        }
    }

    private async Task ToggleArchive(string? roomKey)
    {
        if (roomKey is null) return;
        if (Session.ArchivedRooms.Contains(roomKey))
        {
            Session.ArchivedRooms.Remove(roomKey);
        }
        else
        {
            Session.ArchivedRooms.Add(roomKey);
            Session.Unread[roomKey] = 0;
            if (roomKey == _activeRoom)
            {
                _messages = new();
                _typing.Clear();
            }
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_input))
        {
            await SendMessage();
        }
    }

    private void OnInput(ChangeEventArgs e)
    {
        _input = e.Value?.ToString() ?? "";
        if (_hub is { State: HubConnectionState.Connected } && !string.IsNullOrWhiteSpace(_input))
        {
            if ((DateTimeOffset.Now - _lastTypeSentAt).TotalMilliseconds > 500)
            {
                _lastTypeSentAt = DateTimeOffset.Now;
                _ = FireTyping(true);
            }
        }
    }

    private void StopTyping() => _ = FireTyping(false);

    private async Task FireTyping(bool typing)
    {
        if (_hub is null) return;
        var room = _activeRoom;
        try { await _hub.SendAsync("UserTyping", room, typing); } catch { }
    }

    private async Task SendMessage()
    {
        var text = _input.Trim();
        _input = "";
        if (string.IsNullOrEmpty(text) || _hub is not { State: HubConnectionState.Connected }) return;
        await FireTyping(false);
        try
        {
            await _hub.SendAsync("SendMessage", _activeRoom, text);
        }
        catch { }
        await JS.InvokeVoidAsync("chatFocus", "message-input");
    }

    private bool IsOnline(string id) => ChatState.IsOnline(id);

    private static string InitialOf(string name) => name.Length > 0 ? name[0].ToString() : "?";

    // Razor-local helpers reused in markup lambdas.
    private RenderFragment RoomRow(ChatRoom room) => __builder =>
    {
        <div class="room-row @(room.Key == _activeRoom ? "active" : "")" @onclick="() => SelectRoom(room.Key)">
            <div class="avatar" style="--hue:@room.Hue">@room.Title[0]</div>
            <div class="room-body">
                <div class="room-top">
                    <div class="room-title">
                        @room.Title
                        @if (Session.Unread.TryGetValue(room.Key, out var unread) && unread > 0)
                        {
                            <span class="badge dot">@unread</span>
                        }
                    </div>
                    <div class="room-time">
                        @if (ChatState.LastMessage(room.Key) is { } last)
                        {
                            <text>@last.SentAt.ToLocalTime().ToString("HH:mm")</text>
                        }
                    </div>
                </div>
                <div class="room-bottom">
                    <div class="room-desc">
                        @if (ChatState.LastMessage(room.Key) is { } preview)
                        {
                            <text>@preview.User.DisplayName: @preview.Text</text>
                        }
                        else
                        {
                            <text>No messages yet</text>
                        }
                    </div>
                    @if (room.Key == _activeRoom && _activeOnline.Length > 0)
                    {
                        <div class="online-count">● @_activeOnline.Length</div>
                    }
                </div>
            </div>
        </div>;
    };
}